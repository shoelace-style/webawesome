{% set hasSidebar = true %}
{% set hasOutline = true %}

{# need this override this to get right class #}
{% set layout = "page-outline" %}

{% extends "../_includes/base.njk" %}

{%- block beforeContent -%}
  <wa-breadcrumb class="page-breadcrumbs">
    <wa-icon slot="separator" name="angle-right" variant="regular"></wa-icon>
    <wa-breadcrumb-item href="/docs/frameworks">Frameworks</wa-breadcrumb-item>
    <wa-breadcrumb-item>{{ title }}</wa-breadcrumb-item>
  </wa-breadcrumb>
{%- endblock -%}

{%- block afterContent -%}

{% markdown %}
:::info
Are you using Web Awesome with {{ title }}? [Help us improve this page!](https://github.com/shoelace-style/webawesome/blob/next/packages/webawesome/docs/{{ page | relativeInputPath }})
:::
{% endmarkdown %}

{% endblock %}
