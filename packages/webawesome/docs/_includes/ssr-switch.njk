{% set ssrToggleId = "ssr-toggle-" + ("" | uniqueId(8)) %}
{% raw %}{% set isSSROn = req.cookies.webawesome_ssr === "true" %}{% endraw %}
<wa-button id="{{ ssrToggleId }}" appearance="plain" pill {% raw %}{% if isSSROn %}class="ssr-on"{% endif %}{% endraw %}>
  <wa-icon name="server" label="Server-Side Rendering"></wa-icon>
</wa-button>
<wa-tooltip for="{{ ssrToggleId }}">Server-Side Rendering: {% raw %}{{ "On" if isSSROn else "Off" }}{% endraw %}</wa-tooltip>

<wa-popover for="{{ ssrToggleId }}" class="header-popover ssr-popover" placement="bottom">
  <wa-switch class="header-popover-section" data-ssr-toggle autofocus hint="Server-side rendering (SSR) generates component HTML on the server before the page loads, improving SEO and initial load time. Switching it reloads the page." {% raw %}{{ bool_attr("checked", isSSROn) }}{% endraw %}>
    Server-Side Rendering
  </wa-switch>

  <wa-divider></wa-divider>
  <a class="header-popover-docs-link wa-cluster wa-gap-s" href="/docs/ssr" data-popover="close">
    <wa-icon name="book-open"></wa-icon>
    Docs
  </a>
</wa-popover>
