{% set githubButtonId = "github-repo-button-" + ("" | uniqueId(8)) %}
<wa-button id="{{ githubButtonId }}" href="{{ site.github.repo }}" rel="noopener noreferrer" target="_blank" appearance="plain" pill>
  <wa-icon family="brands" name="github" label="View on GitHub"></wa-icon>
</wa-button>
<wa-tooltip for="{{ githubButtonId }}" distance="2">View on GitHub</wa-tooltip>
