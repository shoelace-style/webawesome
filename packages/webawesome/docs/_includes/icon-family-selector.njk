{# Keep these lists in sync with the saved style check in head.njk, or new styles won't survive a reload #}
{% set iconFamilies = ['classic', 'sharp', 'duotone', 'sharp-duotone'] %}
{% set iconVariants = ['solid', 'regular', 'light', 'thin'] %}
{# This include renders in both the header and the mobile sidebar, so each copy needs its own ID #}
{% set iconFamilyId = "icon-family-" + ("" | uniqueId(8)) %}
<wa-button id="{{ iconFamilyId }}" appearance="plain" pill>
  <wa-icon name="icons" label="Select Icon Style"></wa-icon>
</wa-button>
<wa-tooltip for="{{ iconFamilyId }}" class="icon-family-tooltip">Select Icon Style</wa-tooltip>

<wa-popover for="{{ iconFamilyId }}" class="icon-family-selector" placement="bottom">
  <div class="icon-family-grid" role="radiogroup" aria-label="Icon Style">
    <span></span>
    {% for variant in iconVariants %}
    <span>{{ variant | title }}</span>
    {% endfor %}

    {% for family in iconFamilies %}
    {% set familyName = family | replace('-', ' ') | title %}
    <span>{{ familyName }}</span>
    {% for variant in iconVariants %}
    <label>
      <input class="wa-visually-hidden-force" type="radio" name="{{ iconFamilyId }}" value="{{ family }} {{ variant }}" />
      <wa-icon name="house" family="{{ family }}" variant="{{ variant }}"></wa-icon>
      <span class="wa-visually-hidden">{{ familyName }} {{ variant | title }}</span>
    </label>
    {% endfor %}
    {% endfor %}
  </div>

  <wa-divider></wa-divider>
  <div class="icon-family-footer wa-split wa-gap-m">
    <a class="wa-cluster wa-gap-xs" href="/docs/components/icon#changing-the-default-family-and-variant" data-popover="close">
      <wa-icon name="book-open"></wa-icon>
      Docs
    </a>
    <small>
      Some icons require
      <a href="https://fontawesome.com/icons" rel="noopener noreferrer" target="_blank">{{ site.siblings.fontAwesome.name }} Pro</a>.
    </small>
  </div>
</wa-popover>
